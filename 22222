# ===================== PRIVACY =====================

def anon(uid: int) -> str:
    return hashlib.sha256(str(uid).encode()).hexdigest()[:12]

# ===================== RATE LIMITER =====================

def check_rate_limit(user_id: int) -> bool:
    """Возвращает True если лимит не превышен, False если превышен."""
    key = f"rl:{user_id}:{int(time.time() // RATE_LIMIT_WINDOW)}"
    count = rdb.incr(key)
    if count == 1:
        rdb.expire(key, RATE_LIMIT_WINDOW)
    return count <= RATE_LIMIT_MAX

# ===================== JOB SYSTEM =====================

def create_job(job_type: str, chat_id: int, data: dict) -> str:
    job_id = str(uuid.uuid4())
    payload = {
        "id": job_id,
        "type": job_type,
        "chat_id": chat_id,
        "status": "pending",
        "data": json.dumps(data),
        "created": time.time(),
        "retries": 0
    }
    rdb.lpush("jobs", json.dumps(payload))
    rdb.setex(f"job:{job_id}", JOB_TTL, json.dumps(payload))
    log.info(f"Job created: {job_id} type={job_type} user={anon(chat_id)}")
    return job_id


def update_job(job: dict) -> None:
    rdb.setex(f"job:{job['id']}", JOB_TTL, json.dumps(job))


def get_job(job_id: str) -> dict | None:
    raw = rdb.get(f"job:{job_id}")
    return json.loads(raw) if raw else None


def mark_notified(job_id: str) -> None:
    rdb.lpush("jobs:notified", job_id)
    rdb.ltrim("jobs:notified", 0, 9999)

# ===================== CPU POOL =====================

async def run_cpu(func, *args):
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, func, *args)

# ===================== IMAGE CORE =====================

def decode_bytes(img_bytes: bytes) -> np.ndarray:
    arr = np.frombuffer(img_bytes, np.uint8)
    return cv2.imdecode(arr, cv2.IMREAD_COLOR)


def decode_b64(b64_str: str) -> np.ndarray:
    return decode_bytes(base64.b64decode(b64_str))


def encode_jpg(image: np.ndarray) -> bytes:
    _, buf = cv2.imencode(".jpg", image, [cv2.IMWRITE_JPEG_QUALITY, 90])
    return buf.tobytes()


def encode_png(image: np.ndarray) -> bytes:
    _, buf = cv2.imencode(".png", image)
    return buf.tobytes()

# ===================== AI ENGINE =====================

async def ai_generate(prompt: str) -> bytes:
    async with httpx.AsyncClient(timeout=90) as c:
        resp = await c.post(
            "https://api.openai.com/v1/images/generations",
            headers={"Authorization": f"Bearer {OPENAI_KEY}"},
            json={
                "model": "gpt-image-1",
                "prompt": prompt,
                "size": "1024x1024"
            }
        )
        resp.raise_for_status()
        return base64.b64decode(resp.json()["data"][0]["b64_json"])


async def ai_edit(img_bytes: bytes, prompt: str) -> bytes:
    async with httpx.AsyncClient(timeout=90) as c:
        resp = await c.post(
            "https://api.openai.com/v1/images/edits",
            headers={"Authorization": f"Bearer {OPENAI_KEY}"},
            files={"image": ("img.png", img_bytes, "image/png")},
            data={"prompt": prompt, "model": "gpt-image-1"}
        )
        resp.raise_for_status()
        return base64.b64decode(resp.json()["data"][0]["b64_json"])

