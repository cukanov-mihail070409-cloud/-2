# ===================== AR ENGINE =====================

mp_pose = mp.solutions.pose
pose = mp_pose.Pose(static_image_mode=True)


def get_keypoints(image: np.ndarray) -> dict | None:
    img_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    results = pose.process(img_rgb)

    if not results.pose_landmarks:
        return None

    h, w, _ = image.shape
    lm = results.pose_landmarks.landmark

    def pt(landmark):
        return (
            max(0, min(w - 1, int(lm[landmark].x * w))),
            max(0, min(h - 1, int(lm[landmark].y * h)))
        )

    return {
        "right_wrist": pt(mp_pose.PoseLandmark.RIGHT_WRIST),
        "left_wrist":  pt(mp_pose.PoseLandmark.LEFT_WRIST),
        "mouth":       pt(mp_pose.PoseLandmark.MOUTH_LEFT),
    }


def overlay_object(image: np.ndarray, obj_path: str, position: tuple, size: int = 80) -> np.ndarray:
    if not os.path.exists(obj_path):
        log.warning(f"Overlay asset not found: {obj_path}")
        return image

    obj = Image.open(obj_path).convert("RGBA")
    obj = obj.resize((size, size), Image.LANCZOS)

    img_pil = Image.fromarray(cv2.cvtColor(image, cv2.COLOR_BGR2RGB)).convert("RGBA")

    x, y = position
    # Не выходим за пределы изображения
    x = max(0, min(x - size // 2, img_pil.width - size))
    y = max(0, min(y - size // 2, img_pil.height - size))

    img_pil.paste(obj, (x, y), obj)

    return cv2.cvtColor(np.array(img_pil.convert("RGB")), cv2.COLOR_RGB2BGR)


def ar_overlay(image: np.ndarray) -> np.ndarray:
    keypoints = get_keypoints(image)
    if not keypoints:
        return None  # сигнал что человек не найден

    result = image.copy()

    if os.path.exists("icecream.png"):
        result = overlay_object(result, "icecream.png", keypoints["right_wrist"], size=70)

    if os.path.exists("mic.png"):
        result = overlay_object(result, "mic.png", keypoints["mouth"], size=60)

    return result

# ===================== PLUGINS =====================

class Plugin:
    async def run(self, ctx: dict) -> dict:
        raise NotImplementedError


class GenPlugin(Plugin):
    async def run(self, ctx: dict) -> dict:
        img = await ai_generate(ctx["prompt"])
        return {"type": "image", "data": img, "caption": "🎨 Готово!"}


class EditPlugin(Plugin):
    async def run(self, ctx: dict) -> dict:
        img_bytes = base64.b64decode(ctx["image"])
        result = await ai_edit(img_bytes, ctx["prompt"])
        return {"type": "image", "data": result, "caption": "✏️ Редактирование готово!"}


class ARPlugin(Plugin):
    async def run(self, ctx: dict) -> dict:
        image = await run_cpu(decode_b64, ctx["image"])
        result = await run_cpu(ar_overlay, image)

        if result is None:
            return {"type": "text", "data": None, "caption": "❌ Человек не найден на фото"}

        img_bytes = await run_cpu(encode_jpg, result)
        return {"type": "image", "data": img_bytes, "caption": "🍦 AR overlay готов!"}


class FaceSwapPlugin(Plugin):
    async def run(self, ctx: dict) -> dict:
        src = await run_cpu(decode_b64, ctx["source"])
        tgt = await run_cpu(decode_b64, ctx["target"])
        result = await run_cpu(faceswap, src, tgt)
        img_bytes = await run_cpu(encode_jpg, result)
        return {"type": "image", "data": img_bytes, "caption": "👤 Face swap готов!"}


plugins: dict[str, Plugin] = {
    "gen":      GenPlugin(),
    "edit":     EditPlugin(),
    "ar":       ARPlugin(),
    "faceswap": FaceSwapPlugin(),
}

# ===================== ROUTER =====================

def route(text: str) -> str:
    t = text.lower()
    if "/gen" in t:       return "gen"
    if "/edit" in t:      return "edit"
    if "/swap" in t:      return "faceswap"
    if "/ar" in t:        return "ar"
    return "unknown"

# ===================== FILE LOADER =====================

async def load_file(file_id: str) -> bytes:
    f = await bot.get_file(file_id)
    d = await bot.download_file(f.file_path)
    return d.read()

