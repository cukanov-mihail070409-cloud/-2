@dp.message(Command("status"))
async def cmd_status(message: types.Message):
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Укажи job_id: /status &lt;job_id&gt;", parse_mode="HTML")
        return

    job = get_job(parts[1].strip())
    if not job:
        await message.answer("❌ Задание не найдено (или истёк срок хранения)")
        return

    status_map = {
        "pending": "⏳ В очереди",
        "running": "⚙️ Выполняется",
        "done":    "✅ Готово",
        "error":   "❌ Ошибка",
    }
    status_text = status_map.get(job["status"], job["status"])
    error_info = f"\n<code>{job.get('error', '')}</code>" if job["status"] == "error" else ""

    await message.answer(
        f"Задание <code>{job['id'][:8]}…</code>\n"
        f"Статус: {status_text}{error_info}",
        parse_mode="HTML"
    )


@dp.message(F.photo)
async def handle_photo(message: types.Message):
    user_id = message.from_user.id

    if not check_rate_limit(user_id):
        await message.answer(f"⏱ Слишком много запросов. Подожди немного.")
        return

    raw = await load_file(message.photo[-1].file_id)
    b64 = base64.b64encode(raw).decode()

    caption = message.caption or ""

    if "/edit" in caption.lower():
        prompt = caption.lower().replace("/edit", "").strip()
        if not prompt:
            await message.answer("Укажи что изменить: /edit &lt;описание&gt;", parse_mode="HTML")
            return
        job_id = create_job("edit", user_id, {"image": b64, "prompt": prompt})
        await message.answer(f"✏️ Редактирование в очереди\n<code>{job_id}</code>", parse_mode="HTML")

    elif "/swap" in caption.lower():
        await message.answer("👤 Пришли второе фото с подписью /swap2")

    else:
        job_id = create_job("ar", user_id, {"image": b64})
        await message.answer(f"⚙️ AR обработка в очереди\n<code>{job_id}</code>", parse_mode="HTML")


@dp.message(F.text)
async def handle_text(message: types.Message):
    user_id = message.from_user.id

    if not check_rate_limit(user_id):
        await message.answer("⏱ Слишком много запросов. Подожди немного.")
        return

    intent = route(message.text)

    if intent == "gen":
        prompt = message.text.split(maxsplit=1)[1].strip() if len(message.text.split()) > 1 else ""
        if not prompt:
            await message.answer("Укажи описание: /gen &lt;текст&gt;", parse_mode="HTML")
            return
        job_id = create_job("gen", user_id, {"prompt": prompt})
        await message.answer(f"🎨 Генерация в очереди\n<code>{job_id}</code>", parse_mode="HTML")

    elif intent == "edit":
        await message.answer("📸 Пришли фото с подписью /edit &lt;описание&gt;", parse_mode="HTML")

    elif intent == "faceswap":
        await message.answer("👤 Пришли фото с подписью /swap")

    else:
        await message.answer(
            "Не понял команду. Напиши /help для помощи."
        )

# ===================== WORKER =====================

async def worker(worker_id: int):
    log.info(f"Worker #{worker_id} started")
    while True:
        job_raw = rdb.rpop("jobs")
        if not job_raw:
            await asyncio.sleep(0.2)
            continue

        job = json.loads(job_raw)
        data = json.loads(job["data"])

        if job.get("retries", 0) >= MAX_RETRIES:
            job["status"] = "error"
            job["error"] = "Превышено максимальное количество попыток"
            update_job(job)
            log.warning(f"Job {job['id']} exceeded max retries")
            continue

        log.info(f"Worker #{worker_id} processing job {job['id']} type={job['type']}")

        try:
            job["status"] = "running"
            update_job(job)

            plugin = plugins.get(job["type"])
            if not plugin:
                raise ValueError(f"Unknown plugin: {job['type']}")

            result = await plugin.run(data)

            job["status"] = "done"
            job["result_caption"] = result.get("caption", "")
            if result["type"] == "image" and result["data"]:
                job["result"] = base64.b64encode(result["data"]).decode()
            else:
                job["result"] = None

            update_job(job)
            log.info(f"Job {job['id']} done")

        except Exception as e:
            log.exception(f"Job {job['id']} failed: {e}")
            job["status"] = "error"
            job["error"] = str(e)
            job["retries"] = job.get("retries", 0) + 1
            update_job(job)

            # Вернуть в очередь если есть ещё попытки
            if job["retries"] < MAX_RETRIES:
                rdb.lpush("jobs", json.dumps(job))

# ===================== RESULT NOTIFIER =====================

async def job_poller():
    """Проверяет завершённые задания и отправляет результат пользователю."""
    log.info("Result notifier started")

    notified_key = "jobs:notified_set"

    while True:
        await asyncio.sleep(1)

        # Сканируем ключи завершённых заданий
        cursor = 0
        while True:
            cursor, keys = rdb.scan(cursor, match="job:*", count=100)
            for key in keys:
                raw = rdb.get(key)
                if not raw:
                    continue

                job = json.loads(raw)

                if job["status"] not in ("done", "error"):
                    continue

                job_id = job["id"]

                # Уже уведомляли?
                if rdb.sismember(notified_key, job_id):
                    continue

                rdb.sadd(notified_key, job_id)
                rdb.expire(notified_key, JOB_TTL)

                chat_id = job.get("chat_id")
                if not chat_id:
                    continue

                try:
                    if job["status"] == "error":
                        await bot.send_message(
                            chat_id,
                            f"❌ Задание завершилось с ошибкой:\n<code>{job.get('error', '?')}</code>",
                            parse_mode="HTML"
                        )

                    elif job["status"] == "done":
                        caption = job.get("result_caption", "✅ Готово!")
                        result_b64 = job.get("result")

                        if result_b64:
                            img_bytes = base64.b64decode(result_b64)
                            await bot.send_photo(
                                chat_id,
                                photo=types.BufferedInputFile(img_bytes, filename="result.jpg"),
                                caption=caption
                            )
                        else:
                            await bot.send_message(chat_id, caption)

                except Exception as e:
                    log.error(f"Failed to notify user {chat_id} for job {job_id}: {e}")

            if cursor == 0:
                break

# ===================== STARTUP =====================

async def start_workers():
    for i in range(NUM_WORKERS):
        asyncio.create_task(worker(i))

# ===================== MAIN =====================

async def main():
    log.info("Bot starting...")

    try:
        rdb.ping()
        log.info("Redis connected")
    except redis.ConnectionError:
        log.error("Redis unavailable! Make sure Redis is running.")
        return

    await start_workers()
    asyncio.create_task(job_poller())

    log.info("Polling started")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
